DirectoryIndex index.html

AddType video/mp4 .mp4
AddType image/svg+xml .svg
AddType application/pdf .pdf

<IfModule mod_rewrite.c>
  RewriteEngine On
  # home.html duplicates index.html; keep a single canonical URL.
  RewriteRule ^home\.html$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # HTML, and any un-fingerprinted script.js / styles.css, must revalidate on
  # every load so a stale copy from a previous deploy is never reused.
  <FilesMatch "\.html$|^(script\.js|styles\.css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Vite emits assets/<name>-<8-char hash>.<ext>; those are safe to cache forever.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|svg|mp4|pdf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
